{
  "name": "dsh-web-search-firecrawl",
  "version": "0.1.3",
  "description": "Firecrawl search provider and multi-account settings for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/aa2246740/dsh-firecrawl.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-firecrawl#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-firecrawl/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "firecrawl",
    "web-search"
  ],
  "type": "module",
  "main": "lib/dsh-web-search-firecrawl.js",
  "types": "lib/types/dsh-web-search-firecrawl.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-web-search-firecrawl.d.ts",
      "default": "./lib/dsh-web-search-firecrawl.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
